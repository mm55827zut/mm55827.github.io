{% extends 'base.html.twig' %}

{% block title %}Szczegóły komentarza{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="page-kicker">Podgląd rekordu #{{ comment.id }}</p>
        <h1 class="page-title">Szczegóły komentarza</h1>
    </div>

    <div class="card comment-panel">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">{{ comment.id }}</dd>

                <dt class="col-sm-3">PostId</dt>
                <dd class="col-sm-9">{{ comment.postId }}</dd>

                <dt class="col-sm-3">Content</dt>
                <dd class="col-sm-9 comment-content">{{ comment.content }}</dd>

                <dt class="col-sm-3">GifPath</dt>
                <dd class="col-sm-9">{{ comment.gifPath ?: '—' }}</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a href="{{ path('app_comment_index') }}" class="btn btn-secondary">Powrót do listy</a>
        <a href="{{ path('app_comment_edit', {'id': comment.id}) }}" class="btn btn-primary">Edytuj</a>
        {{ include('comment/_delete_form.html.twig') }}
    </div>
{% endblock %}
