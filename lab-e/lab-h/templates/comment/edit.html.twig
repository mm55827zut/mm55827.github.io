{% extends 'base.html.twig' %}

{% block title %}Edycja komentarza{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="page-kicker">Edycja rekordu #{{ comment.id }}</p>
        <h1 class="page-title">Edytuj komentarz</h1>
    </div>

    <div class="card comment-panel">
        <div class="card-body">
            {{ include('comment/_form.html.twig', {'button_label': 'Zapisz zmiany'}) }}
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a href="{{ path('app_comment_index') }}" class="btn btn-secondary">Powrót do listy</a>
        {{ include('comment/_delete_form.html.twig') }}
    </div>
{% endblock %}
